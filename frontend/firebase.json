{
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "apphosting": [
    {
      "backendId": "starnews-web",
      "rootDir": ".",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        "firebase-debug.log",
        ".env",
        ".env.*",
        "create-admin.js",
        "sync_users.js",
        "tests",
        "test-results",
        "playwright-report",
        "coverage",
        "qa*.env.sh",
        "*.log",
        "public/StarNewsLogo.mp4",
        "public/NEWLOGO.mp4"
      ]
    }
  ]
}