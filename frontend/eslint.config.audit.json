{
  "root": true,
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "plugins": [
    "react-hooks",
    "react",
    "@next/next"
  ],
  "settings": {
    "react": {
      "version": "18.2"
    }
  },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "no-undef": "error",
    "react/jsx-no-undef": "error",
    "react/jsx-key": "error",
    "react/jsx-uses-vars": "error",
    "react/jsx-uses-react": "error",
    "no-unreachable": "error",
    "no-dupe-keys": "error",
    "no-self-assign": "error",
    "no-constant-condition": "warn",
    "no-unused-vars": [
      "warn",
      {
        "args": "none",
        "ignoreRestSiblings": true
      }
    ]
  },
  "globals": {
    "React": "readonly"
  },
  "ignorePatterns": [
    ".next/",
    "node_modules/",
    "public/",
    "tests/",
    "*.disabled"
  ]
}